{
  "name": "@laoyuehanni/dsh-session-tools",
  "version": "0.1.0",
  "description": "DSH plugin: list visible Sessions, hand one message to another Session, and move separate work into a new Session",
  "keywords": [
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "session",
    "cross-session",
    "messaging",
    "handoff"
  ],
  "homepage": "https://github.com/LaoYueHanNi/dsh-session-tools#readme",
  "bugs": {
    "url": "https://github.com/LaoYueHanNi/dsh-session-tools/issues"
  },
  "license": "MIT",
  "author": "LaoYueHanNi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaoYueHanNi/dsh-session-tools.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build:all": "pnpm run build && pnpm run build:client",
    "watch:client": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:decisions": "node docs/decisions/check.mjs",
    "test": "node tests/smoke.mjs && node tests/host-contracts.mjs && node tests/handoff-cards.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run check:decisions && pnpm run build:all && pnpm test"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.2-rc.5"
  },
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0"
  }
}
